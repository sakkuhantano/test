<%@ Register Src="~/UserControls/toast.ascx" TagPrefix="uc1" TagName="toast" %>
<!DOCTYPE html>

<html>

<head runat="server">
<title>Global Utility Services</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" type="text/css" href="/WebFolder/bootstrap-5.3.8-dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="/WebFolder/bootstrap-icons-1.11.3/font/bootstrap-icons.min.css"/>
<link rel="Stylesheet" type="text/css" href="../../WebFolder/Css/styles_2.css" />
<script type="text/javascript" src="../../WebFolder/jquery/jquery-3.7.0.min.js"></script>
<script type="text/javascript" src="../../WebFolder/bootstrap-5.3.0-dist/js/bootstrap.bundle.min.js"></script>
<link rel="Stylesheet" type="text/css" href="../CSSCus/Site1.Master.css" />
<asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body class="antialiased">
<div class="wrapper">
<uc1:toast runat="server" />
<!-- Mobile Overlay -->
<div class="overlay" id="overlay"></div>
<!-- Sidebar -->
<aside class="sidebar overflow-hidden collapsed" id="sidebar" style="overflow-y: hidden !important;">
<div class="sidebar-logo-container py-3 px-3">
<div class="dropdown">
<button aria-expanded="false" class="btn btn-link p-0 text-start text-decoration-none dropdown-toggle w-100" data-bs-toggle="dropdown" type="button">
<img alt="Global Utility Services Logo" class="sidebar-logo mb-2" src="/WebFolder/Images/muliaLogo.png" />
<div class="d-flex align-items-center justify-content-between">
<small class="text-uppercase fw-bold text-muted" style="font-size: 10px; letter-spacing: 0.1em;"><span id="lblCompanySidebar"></span><span id="lblCompanyLocation" class="d-none"></span></small>
<i class="bi bi-buildings text-muted small ms-2"></i>
</div>
</button>
<ul id="companyMenu" class="dropdown-menu dropdown-menu-custom mt-2">
    <li>
        <h6 class="dropdown-header text-uppercase"
            style="font-size: 10px; letter-spacing: 0.1em;">
            Select Company
        </h6>
    </li>
</ul>


<%--<ul class="dropdown-menu dropdown-menu-custom mt-2">
