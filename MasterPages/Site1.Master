<i class="bi bi-box-arrow-right me-3 fs-5"></i>
<span>Logout</span>
</a>
</nav>--%>
<div class="px-3 mt-auto pb-4">
<div class="card-custom p-2 air-shadow mb-2">
<button aria-expanded="false" class="p-2 hover:bg-surface-container rounded-full transition-colors relative border-0 bg-transparent text-slate-600 no-caret" type="button" id="btnProfile">
<div class="d-flex align-items-center gap-2">
<div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0" style="width: 32px; height: 32px; background-color: var(--primary-container);">
<i class="bi bi-person-circle"></i>
</div>
<div class="overflow-hidden">
<p class="mb-0 small fw-bold text-truncate"><span id="lblUserName"></span><span class="d-none" id="lblUserID"></span></p>
<p class="mb-0 text-muted text-truncate" style="font-size: 9px;">ID: <span id="lblNIK"></span></p>
</div>
</div>
</button>
</div>
</div>
</aside>
<!-- Main Content -->
<div id="content" class="expanded">
<!-- Sync Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3"
     style="z-index:1100;">

    <div id="syncToast"
         class="toast air-shadow border-0"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">

        <!-- HEADER -->
        <div class="toast-header bg-white border-0 py-2">

            <!-- Spinner -->
            <div id="syncSpinner"
                 class="spinner-border spinner-border-sm text-primary me-2"
                 role="status">
                <span class="visually-hidden">
                    Loading...
                </span>

            </div>

            <!-- Title -->
            <strong class="me-auto text-primary small fw-bold">

                Synchronizing

            </strong>

            <!-- Close Button -->
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="toast"
                    aria-label="Close">
            </button>

        </div>

        <!-- BODY -->
        <div class="toast-body pt-0 pb-3 bg-white">

            <!-- Progress Text -->
            <div class="d-flex justify-content-between align-items-center mb-1">

                <span id="syncText"
                      class="text-muted small">
                    Preparing sync...
                </span>

                <span id="syncPercentText"
                      class="small fw-bold">
                    0%
                </span>

            </div>

            <!-- Progress Bar -->
            <div class="progress"
                 style="height:4px;">
                <div id="syncProgressBar"
                     class="progress-bar"
                     role="progressbar"
                     style="width:0%; background-color:var(--primary-container);"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-valuenow="0">

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Top Navbar -->
<%--<header class="top-navbar px-3 px-lg-4 px-xl-5 py-3">
<div class="container-fluid p-0">
<div class="d-flex align-items-center justify-content-between">

