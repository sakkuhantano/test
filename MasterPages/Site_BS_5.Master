    <style>
        /*
        #navbarSupportedContent .nav-link:hover::after {
            content:'';
            display:block;
            border-bottom:1px solid #0b63dc;
            width:50%;
            margin:auto;
        }
        */
        #navbarSupportedContent .nav-link:hover {
            color:white;
        }
        #navbarSupportedContent .nav-link {
            color:#ccc;
        }
        #navbarSupportedContent .dropdown-item:hover {
            color:white;
        }
        #navbarSupportedContent .dropdown-item {
            color:#ccc;
        }
        #navbarSupportedContent .dropdown-menu {
            margin-top: 0;
            background-color: #000000;
	        background-image: linear-gradient(147deg, #000000 0%, #2c3e50 74%);
            /*background-color: #2c3e50;*/
            color:white;
            border:0px solid black;
        }
        #navbarSupportedContent .dropdown-menu .dropdown-toggle {
            margin-top: 0;
            background-color: #000000;
	        background-image: linear-gradient(147deg, #000000 0%, #2c3e50 74%);
            /*background-color: #2c3e50;*/
            color:white;
            border:0px solid black;
        }
        #navbarSupportedContent .dropdown-menu .dropdown-toggle::after {
            vertical-align: middle;
            border-left: 4px solid;
            border-bottom: 4px solid transparent;
            border-top: 4px solid transparent;
        }
        #navbarSupportedContent .dropdown-menu .dropdown .dropdown-menu {
            left: 100%;
            top: 0%;
            margin:0 20px;
            /*border-width: 0;*/
        }
        #navbarSupportedContent .dropdown-menu .dropdown .dropdown-menu.left {
            right: 100%;
            left: auto;
        }

        #navbarSupportedContent .dropdown-menu > li a:hover,
        #navbarSupportedContent .dropdown-menu > li.show {
	        /*background: #007bff;*/
	        /*color: white;*/
            background-image: linear-gradient( 109.6deg,  rgba(44,83,131,1) 18.9%, rgba(95,175,201,1) 91.1% );
        }
        #navbarSupportedContent .dropdown-menu > li.show > a{
	        /*color: white;*/
        }

        @media (min-width: 768px) {
            #navbarSupportedContent .dropdown-menu .dropdown .dropdown-menu {
                margin:0;
                /*border-width: 1px;*/
                /*background-color: #000000;*/
	            /*background-image: linear-gradient(147deg, #000000 0%, #2c3e50 74%);*/
                color:white;
            }
            /*#navbarSupportedContent .nav-link:hover {
                border-bottom:1px solid lightblue;
                padding-bottom:7px;
            }*/
        }
    </style>
    <script type="text/javascript">
        //document.getElementById("navbarSupportedContent").style.marginLeft = "-5px";

        (function ($) {
            var defaults = {
                sm: 540,
                md: 720,
                lg: 960,
                xl: 1140,
                navbar_expand: 'lg',
                animation: true,
                animateIn: 'fadeIn',
            };
            $.fn.bootnavbar = function (options) {

                var screen_width = $(document).width();
                settings = $.extend(defaults, options);

                //alert(screen_width + ' ' + settings.lg);

                //if (screen_width >= settings.lg) {
                $(this).find('.dropdown').hover(function () {
                    $(this).addClass('show');
                    $(this).find('.dropdown-menu').first().addClass('show');
                    if (settings.animation) {
                        $(this).find('.dropdown-menu').first().addClass('animated ' + settings.animateIn);
                    }
                }, function () {
                    $(this).removeClass('show');
                    $(this).find('.dropdown-menu').first().removeClass('show');
                });
                //}

                $('.dropdown-menu a.dropdown-toggle').on('click', function (e) {
                    if (!$(this).next().hasClass('show')) {
                        $(this).parents('.dropdown-menu').first().find('.show').removeClass("show");
                    }
                    var $subMenu = $(this).next(".dropdown-menu");
                    $subMenu.toggleClass('show');

                    $(this).parents('li.nav-item.dropdown.show').on('hidden.bs.dropdown', function (e) {
                        $('.dropdown-submenu .show').removeClass("show");
                    });

                    return false;
                });
            };
        })(jQuery);
        $(function () {
            $('#main_navbar').bootnavbar();
        })
    </script>


    <style>
        /*::-webkit-scrollbar {
          width: 1px;
        }*/
        body {
		    overscroll-behavior-y: contain;
	    }

        #main_navbar_toggler {
            display:none;
        }

        #main_navbar_toggler svg {
            /*margin-bottom:2px;*/
        }
        
        #tbl_content1 {
            width:99%;
        }

        @media only screen and (max-width: 768px) {
            #row_menu_header {
                margin-bottom:10px;
            }


            #main_navbar_toggler {
                display:block;
            }
            #main_navbar_toggler svg {
                /*margin-bottom:0px;*/
            }


            #div_col_toolbar1 {
                overflow:auto;
                white-space: nowrap;
                width:97vw;
            }
            #div_col_toolbar1::-webkit-scrollbar {
                display: none;
            }
            #div_col_toolbar1 {
                -ms-overflow-style: none;  
                scrollbar-width: none;  
            }  


            #tbl_content1 {
                width:98%;
            }
        }

        @media only screen and (min-width: 768px) {
            #main_navbar {
                margin-left:-5px;
            }
        }
    </style>
    <script>

    </script>

