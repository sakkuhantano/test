        <asp:HiddenField runat="server" ID="hf_MP_Position" Value="" />
        <script type="text/javascript">
            $(function () {
                var f = $("#<%=hf_MP_Position.ClientID%>");
                window.onload = function () {
                    var position = parseInt(f.val());
                    if (!isNaN(position)) {
                        //$(window).scrollTop(position);
                        window.scrollTo({
                            top: position,
                            left: 0,
                            behavior: 'instant'
                        });
                    }
                };
                window.onscroll = function () {
                    f.val($(window).scrollTop());
                };
            });
        </script>
    </div>
